# # Documentation example only; never reuse this signing-key placeholder.
# NODE_ENV=development
# PORT_API=3000
# PORT_BATCH=3001
# MONGO_DEV=mongodb://127.0.0.1:27017/skiresort_dev
# MONGO_PROD=mongodb://127.0.0.1:27017/skiresort_prod
# SECRET_TOKEN=REPLACE_WITH_A_GENERATED_SECRET

# Durable chat: configure server-only credentials locally; never expose the token to browsers.
# UPSTASH_REDIS_REST_URL=https://YOUR_DATABASE.upstash.io
# UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_YOUR_SERVER_TOKEN
# CHAT_HISTORY_KEY=skiresort:development:chat:messages
# Production must use a separate key, e.g. skiresort:production:chat:messages.
